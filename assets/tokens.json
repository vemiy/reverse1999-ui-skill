{
  "$comment": "平台无关的设计变量。单位是逻辑像素：CSS px = iOS pt = Android dp = Flutter 逻辑像素；小程序乘 2 得 rpx。",
  "name": "re1999-ui",
  "version": "0.1.0",

  "color": {
    "dark": {
      "void": "#0B0A09",
      "deep": "#12100E",
      "panel": "#000000D0",
      "panelSolid": "#141210",
      "paper": "#E9DCCD",
      "paperShade": "#DCCDBA",
      "cream": "#FFFDE9",
      "creamMuted": "#C9C2B4",
      "ink": "#171310",
      "inkMuted": "#5B544B",
      "rust": "#B55829",
      "rustBright": "#DB6F39",
      "amber": "#FF9E34",
      "grey": "#8C8D8C",
      "ok": "#8EC755",
      "due": "#F56064",
      "settled": "#888888"
    },
    "light": {
      "void": "#E9DCCD",
      "deep": "#DFD1BF",
      "panel": "#F3EADE",
      "panelSolid": "#F3EADE",
      "paper": "#F7F1E6",
      "paperShade": "#E2D5C3",
      "cream": "#171310",
      "creamMuted": "#5B544B",
      "ink": "#171310",
      "inkMuted": "#5B544B",
      "rust": "#9A4620",
      "rustBright": "#B55829",
      "amber": "#A85C14",
      "grey": "#6E685F",
      "ok": "#345D1B",
      "due": "#A32B30",
      "settled": "#5B544B"
    }
  },

  "contrast": {
    "$comment": "按 WCAG 公式实测。锈红在深底 4.1:1、在米纸 3.5:1，只能做线、大字号和图标，不做正文。",
    "creamOnVoidDark": "19.3:1",
    "creamMutedOnVoidDark": "11.2:1",
    "creamOnRust": "4.7:1",
    "rustOnVoidDark": "4.1:1",
    "rustOnPaperLight": "3.5:1",
    "rustAccentOnPaperLight": "4.5:1",
    "inkOnPaper": "13.7:1",
    "inkMutedOnPaper": "5.5:1",
    "okOnVoidDark": "9.8:1",
    "dueOnVoidDark": "6.3:1",
    "settledOnVoidDark": "5.6:1",
    "okOnPaperLight": "5.4:1",
    "dueOnPaperLight": "5.0:1",
    "settledOnPaperLight": "5.2:1"
  },

  "font": {
    "serif": "\"Noto Serif SC\", \"Source Han Serif SC\", \"Songti SC\", \"SimSun\", serif",
    "display": "\"Bodoni Moda\", \"Didot\", \"Playfair Display\", \"Times New Roman\", serif",
    "mono": "ui-monospace, \"SF Mono\", Consolas, monospace",
    "size": {
      "display": 64,
      "title": 40,
      "h2": 28,
      "h3": 20,
      "lead": 18,
      "body": 16,
      "small": 14,
      "meta": 12,
      "label": 11
    },
    "line": {
      "display": 1.08,
      "title": 1.18,
      "body": 1.9,
      "compact": 1.5
    },
    "tracking": {
      "latinLabel": "0.22em",
      "latinDisplay": "0.04em",
      "chineseLabel": "0.08em",
      "body": "0.01em"
    },
    "weight": {
      "regular": 400,
      "medium": 500,
      "bold": 700
    }
  },

  "space": { "xs": 4, "sm": 8, "md": 16, "lg": 24, "xl": 40, "xxl": 64, "section": 96 },

  "radius": {
    "none": 0,
    "sm": 10,
    "md": 20,
    "lg": 30,
    "pill": 45,
    "$comment": "不对称圆角 0 lg 0 0 是面板与卡片的固定语言：切掉的那一角表示这块内容可以展开。"
  },

  "line": {
    "hair": 1,
    "strong": 2,
    "active": 4
  },

  "texture": {
    "grain": "160px 平铺的灰度噪声，深色模式下 overlay 5.5%，浅色模式下 multiply 4%",
    "rain": "101° 方向的极细斜线，两层不同间距，遮罩到画面中心淡化",
    "halftone": "6px 周期、1.5px 圆点，只用于小面积标签底",
    "paper": "米纸底加极淡纤维噪点与横向纹理",
    "vignette": "径向压暗，四角到中心"
  },

  "motion": {
    "duration": { "enter": 500, "exit": 350, "hover": 200, "slowSpin": 60000, "rainDrift": 90000 },
    "ease": {
      "enter": "cubic-bezier(0.22, 0.61, 0.36, 1)",
      "exit": "cubic-bezier(0.33, 0, 0.2, 1)",
      "linear": "linear"
    },
    "shift": { "enter": 32, "exit": 16, "$comment": "入退场位移，单位逻辑像素，对应 2rem / 1rem" },
    "stagger": 60,
    "$comment": "只做淡入与位移，不做弹跳、缩放、发光。减少动态效果开启时全部关闭。"
  },

  "rarity": {
    "$comment": "六级色带，取自 wiki 物品列表的卡面底板（Bgequip1..6.png）。物品卡是白卡纸 + 底部色带，不是描边框。",
    "1": { "band": "#C6C6C6", "card": "#FFFFFF", "name": "灰" },
    "2": { "band": "#496441", "card": "#FFFFFF", "name": "墨绿" },
    "3": { "band": "#545C7D", "card": "#FFFFFF", "name": "蓝灰" },
    "4": { "band": "#A672B2", "card": "#FFFFFF", "name": "紫" },
    "5": { "band": "#DBC379", "card": "#F3E8CF", "name": "金" },
    "6": { "band": "#CC7722", "card": "#E9D8AF", "name": "铜橙" }
  },
  "variant": {
    "fixed": [
      "深底质感页 + 米纸面板，两种表面不混用",
      "只有一种强调色：锈红，只做线、大字、当前项，不做大面积填充",
      "1px 细线是通用边界，悬停只加 1px 强调色线",
      "不对称圆角 0 30 0 0 表示可展开",
      "中文宋体 + 英文 Didone 衬线大写字距",
      "编号、日期、状态、计数都是真实数据",
      "红色只给时间状态，不给删除",
      "动效只淡入与位移"
    ],
    "dimensions": {
      "accent": ["rust", "amber", "verdigris", "gold"],
      "surface": ["void", "deep", "paper"],
      "corner": ["sm", "lg", "none"],
      "texture": ["rain", "halftone", "paper", "plain"],
      "density": ["compact", "standard", "roomy"],
      "motion": ["full", "calm"]
    },
    "presets": {
      "archive":  { "accent": "rust",      "surface": "void",  "corner": "lg", "texture": "rain",     "density": "standard", "motion": "full" },
      "nightrain":{ "accent": "verdigris", "surface": "deep",  "corner": "lg", "texture": "rain",     "density": "standard", "motion": "calm" },
      "salon":    { "accent": "gold",      "surface": "void",  "corner": "sm", "texture": "halftone", "density": "roomy",    "motion": "full" },
      "dossier":  { "accent": "rust",      "surface": "paper", "corner": "none", "texture": "paper",  "density": "compact",  "motion": "calm" }
    },
    "accentValues": {
      "rust": "#B55829",
      "amber": "#C97A2B",
      "verdigris": "#4F7D6A",
      "gold": "#B08D4F"
    }
  }
}
